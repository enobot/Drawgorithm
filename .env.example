# Copy this file to .env.local and fill in your Supabase project's values
# (Supabase dashboard: Project Settings → API). .env.local is never committed.
# Restart `npm run dev` after changing it.

# Project URL, like https://abcd1234.supabase.co
VITE_SUPABASE_URL=

# The public key, under either name (use the one Supabase's Connect window shows):
#   VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   the newer "publishable" key
#   VITE_SUPABASE_ANON_KEY=eyJ...                      the older "anon" key
# If both are set, the publishable one is used.
# Never put the service_role / secret key here: anything in this file ends up in the website.
VITE_SUPABASE_ANON_KEY=

# Set to true after enabling Google under Authentication → Sign In / Providers.
VITE_SUPABASE_GOOGLE=false
